{
  "name": "studymate-highschool",
  "version": "1.0.0",
  "description": "StudyMate 高中版：你的 AI 高中学霸伴学助手。支持 Google Antigravity、OpenCode 与 DSH 多平台。",
  "bin": {
    "studymate": "bin/studymate.mjs"
  },
  "exports": {
    ".": "./bin/dsh-plugin.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vitepress dev site --port 5173",
    "build": "py -3 scripts/sync_to_vitepress.py && vitepress build site",
    "sync": "py -3 scripts/sync_to_vitepress.py",
    "preview": "vitepress preview site",
    "install:antigravity": "powershell -ExecutionPolicy Bypass -File ./install-antigravity.ps1",
    "install:opencode": "powershell -ExecutionPolicy Bypass -File ./install-opencode.ps1",
    "install:dsh": "powershell -ExecutionPolicy Bypass -File ./install.ps1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "author": "Cattofu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yulaoshizuikeai/Study-Mate-vue.git"
  },
  "homepage": "https://github.com/Miaotofu01/Study-Mate#readme",
  "bugs": {
    "url": "https://github.com/Miaotofu01/Study-Mate/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "studymate",
    "learning",
    "education"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@mdit/plugin-katex": "^1.1.1",
    "katex": "^0.18.9",
    "markdown-it-container": "^4.0.0",
    "markdown-it-mathjax3": "^4.3.2",
    "vitepress": "^1.6.4"
  }
}
